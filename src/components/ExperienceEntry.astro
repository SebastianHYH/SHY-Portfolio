---
import type { Entry } from '../data/experience';

interface Props {
  entry: Entry;
}
const { entry: e } = Astro.props;
---

<li class="entry">
  <p class="entry-date">{e.period}</p>
  <div>
    <h4 class="entry-title">
      {e.role ? <>{e.role}, <span class="entry-org">{e.org}</span></> : e.org}
    </h4>
    {
      e.roles && (
        <ul class="roles">
          {e.roles.map((r) => (
            <li>
              <span>{r.title}</span> <span class="role-period">{r.period}</span>
            </li>
          ))}
        </ul>
      )
    }
    <p class="entry-text">{e.summary}</p>
    {
      e.tags && (
        <ul class="chips" aria-label="Skills">
          {e.tags.map((t) => <li>{t}</li>)}
        </ul>
      )
    }
  </div>
</li>
