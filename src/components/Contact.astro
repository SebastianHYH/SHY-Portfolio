---
import { site } from '../data/site';
---

<section id="contact" class="section contact" aria-labelledby="contact-h">
  <h2 id="contact-h" class="section-title">Contact</h2>
  <p class="contact-lead">
    Email is the fastest way to reach me. I'm also on
    <a href={site.linkedinUrl} target="_blank" rel="noopener">LinkedIn</a>.
  </p>
  <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
</section>
