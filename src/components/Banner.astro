---
import { withBase } from '../lib/util';

const images = [1, 2, 3, 4, 5].map((n) => withBase(`files/img/banner${n}.webp`));
// Duplicated once so the track loops seamlessly (animation translates -50%).
const loop = [...images, ...images];
---

<div class="image-banner" aria-hidden="true">
  <div class="banner-track">
    {loop.map((src) => <img src={src} alt="" loading="lazy" />)}
  </div>
</div>
