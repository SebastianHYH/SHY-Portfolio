---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLanguages } from '../lib/github';
import { withBase } from '../lib/util';

const brandName = site.name.replace(' ', '<br>');
const languages = await getLanguages();
---

<header class="sidebar">
  <div class="sidebar-top">
    <a class="brand" href="#about" aria-label={`${site.name} — home`}>
      <img src={withBase('files/x-icon.svg')} alt="" width="32" height="36" />
      <span class="brand-text">
        <span class="brand-name" set:html={brandName}></span>
        <span class="brand-role">{site.role}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="primary-nav" class="primary-nav" aria-label="Primary">
    {
      site.availability && (
        <p class="availability">
          <span class="status-dot" />
          {site.availability}
        </p>
      )
    }

    <ul class="sidebar-links">
      <li><a href="#about"><Icon name="user" /> About</a></li>
      <li><a href="#projects"><Icon name="grid" /> Projects</a></li>
      <li><a href="#contact"><Icon name="mail" /> Contact</a></li>
    </ul>

    {
      languages.length > 0 && (
        <div class="sidebar-tech">
          <p class="sidebar-label">Tech I use</p>
          <ul class="tech-list">
            {languages.map((lang) => (
              <li>
                <span class="lang-dot" style={`background:${lang.color}`} />
                {lang.name}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <a class="btn sidebar-cv" href={withBase(site.cv)} target="_blank" rel="noopener">
      <Icon name="arrow" /> Download CV
    </a>

    <div class="sidebar-social">
      <a href={site.linkedinUrl} target="_blank" rel="noopener" aria-label="LinkedIn">
        <Icon name="linkedin" />
      </a>
      <a href={site.githubUrl} target="_blank" rel="noopener" aria-label="GitHub">
        <Icon name="github" />
      </a>
      <a href={`mailto:${site.email}`} aria-label="Email">
        <Icon name="mail" />
      </a>
    </div>
  </nav>
</header>
