---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { withBase } from '../lib/util';

const [first, ...rest] = site.name.split(' ');
const heading = `${first}<br>${rest.join('&nbsp;')}`;
---

<section class="hero" id="about">
  <div class="hero-text reveal">
    <p class="eyebrow">{site.role}</p>
    <h1 set:html={heading}></h1>
    <p class="lead">{site.tagline}</p>
    <div class="btn-social">
      <a href={withBase(site.cv)} target="_blank" rel="noopener" class="btn">
        Download CV
        <Icon name="arrow" />
      </a>
      <a href="#projects" class="btn btn-ghost">View projects</a>
    </div>
  </div>
  <div class="hero-photo reveal">
    <img
      src={withBase('files/img/profile.webp')}
      alt={`Portrait of ${site.name}`}
      width="640"
      height="640"
    />
  </div>
</section>
