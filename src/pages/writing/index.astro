---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { getPosts, formatDate } from '../../lib/writing';
import { site } from '../../data/site';

const posts = await getPosts();
const intro = "Notes on code, life and whatever's on my mind.";
---

<Base title={`Writing | ${site.name}`} description={intro}>
  <main id="content" class="page">
    <header class="page-head">
      <h1 class="page-title">Writing</h1>
      <p class="page-lede">{intro}</p>
    </header>

    {
      posts.length > 0 ? (
        <ol class="post-list">
          {posts.map((p) => (
            <li>
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
              <div>
                <h2 class="post-list-title">
                  <a href={`/writing/${p.id}/`}>{p.data.title}</a>
                  {p.data.draft && <span class="draft-badge">Draft</span>}
                </h2>
                <p class="post-list-desc">{p.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="page-lede">No posts yet.</p>
      )
    }
    <Footer />
  </main>
</Base>
