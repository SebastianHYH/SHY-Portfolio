---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { getPosts, formatDate, type Post } from '../../lib/writing';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, updated, tags, draft, paper, repo } = post.data;
---

<Base title={`${title} | ${site.name}`} description={description}>
  <main id="content" class="page">
    <article class="post">
      <p class="post-back"><a href="/writing/">All writing</a></p>
      <header class="post-head">
        <h1 class="page-title">{title}</h1>
        <p class="post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <span>Updated {formatDate(updated)}</span>}
          {draft && <span class="draft-badge">Draft</span>}
        </p>
        {
          (paper || repo) && (
            <p class="post-links">
              {paper && <a href={paper} target="_blank" rel="noopener">Read the full paper</a>}
              {repo && <a href={repo} target="_blank" rel="noopener">Source code</a>}
            </p>
          )
        }
        {
          tags.length > 0 && (
            <ul class="chips" aria-label="Tags">
              {tags.map((t) => <li>{t}</li>)}
            </ul>
          )
        }
      </header>

      <div class="post-body">
        <Content />
      </div>
    </article>
    <Footer />
  </main>
</Base>
