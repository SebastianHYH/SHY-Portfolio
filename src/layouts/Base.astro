---
import '../styles/global.css';
import { site } from '../data/site';
import { withBase } from '../lib/util';
import TopBar from '../components/TopBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.name,
  description = `${site.headline} ${site.intro}`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('files/img/og.jpg', site.url).href;
const favicon = withBase('files/x-icon.svg');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f1f3f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11161e" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={favicon} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Apply a saved theme before first paint so there's no flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      // Play the intro entrance once per visit, not on every page load.
      try {
        if (!sessionStorage.getItem('entered')) {
          document.documentElement.classList.add('enter');
          sessionStorage.setItem('entered', '1');
        }
      } catch {}
    </script>

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <TopBar />
    <slot />

    <script>
      // ---- Theme toggle -----------------------------------------------------
      const root = document.documentElement;
      const prefersDark = matchMedia('(prefers-color-scheme: dark)');
      const current = () =>
        root.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');

      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

      toggle?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        // Restart the icon turn on every click.
        toggle.classList.remove('turn');
        void toggle.offsetWidth;
        toggle.classList.add('turn');
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      // ---- Scroll-spy for the section nav ------------------------------------
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
      const sections = links
        .map((l) => document.querySelector(l.hash))
        .filter((el): el is Element => el !== null);

      // A single accent bar slides between the section links.
      const tocList = document.querySelector<HTMLElement>('.toc ul');
      function moveIndicator(link: HTMLElement) {
        if (!tocList) return;
        tocList.style.setProperty('--ind-y', `${link.offsetTop}px`);
        tocList.style.setProperty('--ind-h', `${link.offsetHeight}px`);
        tocList.classList.add('has-indicator');
      }

      if ('IntersectionObserver' in window && sections.length) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              for (const l of links) {
                const on = l.hash === `#${entry.target.id}`;
                l.classList.toggle('active', on);
                if (on) {
                  l.setAttribute('aria-current', 'true');
                  moveIndicator(l);
                } else l.removeAttribute('aria-current');
              }
            }
          },
          { rootMargin: '-30% 0px -60% 0px' },
        );
        sections.forEach((s) => spy.observe(s));
      }

      // ---- "Show N more": animate the height instead of snapping -----------
      for (const details of document.querySelectorAll<HTMLDetailsElement>('.more-entries')) {
        const summary = details.querySelector('summary');
        const body = details.querySelector<HTMLElement>(':scope > :not(summary)');
        if (!summary || !body) continue;
        let running: Animation | null = null;
        let wantOpen = details.open;

        summary.addEventListener('click', (e) => {
          if (reduceMotion.matches) return;
          e.preventDefault();
          // Start from the current height, so a click mid-animation reverses it.
          const from = details.open ? body.getBoundingClientRect().height : 0;
          running?.cancel();
          const opening = (wantOpen = !wantOpen);
          details.open = true;
          const to = opening ? body.offsetHeight : 0;

          body.style.overflow = 'hidden';
          running = body.animate(
            [
              { height: `${from}px`, opacity: opening ? 0 : 1 },
              { height: `${to}px`, opacity: opening ? 1 : 0 },
            ],
            { duration: 320, easing: 'cubic-bezier(.4, 0, .2, 1)' },
          );
          running.onfinish = () => {
            if (!opening) details.open = false;
            body.style.overflow = '';
            running = null;
          };
        });
      }
    </script>
  </body>
</html>
